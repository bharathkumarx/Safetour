# SafeTour Backend Environment Variables
# Copy to .env and adjust as needed

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/safetour

# HTTP server port
PORT=3000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Data version identifier (used for cache busting / freshness)
DATA_VERSION=demo-2026-01

# Polling interval for data version changes (seconds)
DATA_POLL_SECONDS=30

# Overpass API base URLs (comma-separated)
OVERPASS_URLS=https://overpass-api.de/api/interpreter

# Delay between Overpass tile requests (milliseconds)
OVERPASS_TILE_DELAY_MS=10000

# User agent for Overpass requests (must not contain example.com)
OVERPASS_USER_AGENT=SafeTour/0.1 (+https://github.com/your-org/safetour)

# Maximum minutes a tile can stall before retry
OVERPASS_STALL_MINUTES=20

# When true, only use cached Overpass tiles (no network requests)
OVERPASS_FROM_CACHE_ONLY=0